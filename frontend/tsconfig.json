{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": [
			"DOM",
			"ES2020"
		],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
	},
	"include": ["src"],
	"ts-node": {
		"compilerOptions": {
			"module": "CommonJS"
		}
	}
}